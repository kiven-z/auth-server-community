<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.auth.service.system.admin.mapper.admin.user.SysUserConfigMapper">

    <!-- 按用户与白名单配置键批量查询 -->
    <select id="selectListByUserIdAndConfigKeys"
            resultType="com.auth.service.system.admin.model.entity.SysUserConfigEntity">
        SELECT
        id,
        user_id,
        config_key,
        config_value,
        created_at,
        updated_at,
        created_by,
        updated_by,
        version,
        remark
        FROM
        sys_user_config
        WHERE
        user_id = #{userId}
        AND config_key IN
        <foreach collection="configKeys" item="configKey" open="(" separator="," close=")">
            #{configKey}
        </foreach>
    </select>

</mapper>
