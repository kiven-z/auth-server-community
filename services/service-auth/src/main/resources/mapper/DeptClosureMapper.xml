<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.auth.service.auth.mapper.DeptClosureMapper">

    <!-- DEPT_AND_CHILD：批量锚点 → 锚点与后代配对 -->
    <select id="selectDescendantRowsByAncestorIds"
            resultType="com.auth.service.auth.model.po.scope.DeptClosureDescendantRowPO">
        SELECT
        dc.ancestor_id AS ancestorId,
        dc.descendant_id AS descendantId
        FROM
        dept_closure dc
        INNER JOIN sys_dept d ON d.id = dc.descendant_id
        <where>
            <choose>
                <when test="ancestorDeptIds != null and ancestorDeptIds.size() > 0">
                    dc.ancestor_id IN
                    <foreach collection="ancestorDeptIds" item="deptId" open="(" separator="," close=")">
                        #{deptId}
                    </foreach>
                </when>
                <otherwise>
                    1 = 0
                </otherwise>
            </choose>
        </where>
        ORDER BY
        dc.ancestor_id,
        dc.descendant_id
    </select>

</mapper>
