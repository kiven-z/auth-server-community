# =============================================================================
# service-system 敏感环境变量（唯一说明来源）
# 复制为同目录 service-system.env 后填写；勿提交真实密钥
# 阿里云短信：SMS DYPNS
# =============================================================================

# -----------------------------------------------------------------------------
# 必填（启用对应渠道 / 平台时填写；值留空，勿写仓库默认口令）
# -----------------------------------------------------------------------------

# 邮件（SMTP）— spring.mail；默认 smtp.qq.com:465
# SMTP 登录邮箱
AUTH_EMAIL_CONFIG_USERNAME=
# SMTP 授权码（不是登录密码）
AUTH_EMAIL_CONFIG_PASSWORD=

# 短信（阿里云 DYPNS）— auth.message.sms
AUTH_SMS_ACCESS_KEY_ID=
AUTH_SMS_ACCESS_KEY_SECRET=

# 钉钉工作通知 — auth.message.ding-talk
# 微应用 AgentId
AUTH_DING_TALK_AGENT_ID=
# AppKey（Client ID）
AUTH_DING_TALK_CLIENT_ID=
# AppSecret（Client Secret）
AUTH_DING_TALK_CLIENT_SECRET=

# 文件存储 — auth.file.platforms；默认平台见 application-dev/prod.yml（可被 Nacos 覆盖）
# 切阿里云时：改 default-platform=ALIYUN_OSS，并填写下面密钥
AUTH_FILE_ALIYUN_OSS_ACCESS_KEY_ID=
AUTH_FILE_ALIYUN_OSS_ACCESS_KEY_SECRET=

# -----------------------------------------------------------------------------
# 可选（jar / yml 已有默认；需覆盖时取消注释）
# 生产务必改密；勿沿用仓库内 Dev1234! / admin
# 注意：当前 compose 仅将本文件注入 service-system；
#       AUTH_DB_* / AUTH_REDIS_PASSWORD 若也要进 service-auth，需另行挂 env_file
# -----------------------------------------------------------------------------

# --- 数据源 / Redis（application-prod.yml）---
# AUTH_DB_USERNAME=root
# AUTH_DB_PASSWORD=
# AUTH_REDIS_PASSWORD=

# --- 消息渠道开关 — auth.message.* ---
# AUTH_SERVICE_SYSTEM_MESSAGE_CHANNEL_EMAIL_ENABLED=true
# AUTH_SERVICE_SYSTEM_MESSAGE_CHANNEL_SMS_ALIYUN_DYPNS_ENABLED=true
# AUTH_SERVICE_SYSTEM_MESSAGE_CHANNEL_DING_TALK_ENABLED=true
# AUTH_SMS_SIGN_NAME=速通互联验证码

# --- MinIO — auth.file.platforms.MINIO ---
# AUTH_FILE_MINIO_ENDPOINT=http://minio:9000
# AUTH_FILE_MINIO_ACCESS_KEY=
# AUTH_FILE_MINIO_SECRET_KEY=
# AUTH_FILE_MINIO_BUCKET=auth-files-prod
# AUTH_FILE_MINIO_PUBLIC_URL=
