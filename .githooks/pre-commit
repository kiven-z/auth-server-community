#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
FORMATTER="${REPO_ROOT}/spring-format.sh"

if [[ -f "$FORMATTER" ]]; then
  echo "pre-commit: running spring-format.sh..."
  "$FORMATTER"
  echo "pre-commit: re-staging formatted tracked files..."
  git add -u
  echo "pre-commit: formatting complete."
else
  echo "pre-commit: spring-format.sh not found at ${FORMATTER}; skipping." >&2
fi

